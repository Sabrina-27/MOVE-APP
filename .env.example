# GEMINI_API_KEY: Chave para chamadas de IA via Google GenAI (injetada automaticamente pelo AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Chave para chamadas de IA via OpenAI (opcional; se fornecida, utilizada pelo assistantService)
OPENAI_API_KEY="sk-..."

# APP_URL: URL do aplicativo no Cloud Run ou ambiente de desenvolvimento
APP_URL="MY_APP_URL"

# PORT: Porta do servidor Express (padrão: 3000)
PORT=3000
